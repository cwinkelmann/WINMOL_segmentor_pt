.idea/
__pycache__/
*.pyc
.venv/
build/
dist/
*.egg-info/
output/
results/
# ...and a symlink named `results`: the trailing-slash form above matches a directory
# only, so a convenience symlink to artifacts elsewhere on the machine slipped past it
# and got committed once. This form catches both.
/results

# Derived training tiles. Built from the corpus on /Volumes/storage/Datasets/Winmol;
# regenerate with scripts/make_splits.py rather than committing (a beech dataset is
# ~1 GB of jpeg/gif, and it is reproducible from the config + the source shapefiles).
/data/

# Host-specific credentials scratch file (never commit)
configs/mount.txt
